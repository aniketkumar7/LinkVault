{
  "id": "/",
  "name": "Bookmarky - Save Your Links",
  "short_name": "Bookmarky",
  "description": "Save and organize links, documents, and screenshots.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f0f0f",
  "theme_color": "#0f0f0f",
  "icons": [
    {
      "src": "/Logo.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "sharedFiles",
          "accept": ["image/*", "application/pdf", ".pdf"]
        }
      ]
    }
  }
}
